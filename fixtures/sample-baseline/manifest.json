        "source": "math"
      }
    ],
    "validation": [
      {
        "path": "validation/general.jsonl",
        "source": "general"
      },
      {
        "path": "validation/education.jsonl",
        "source": "education"
      },
      {
        "path": "validation/code.jsonl",
        "source": "code"
      },
      {
        "path": "validation/math.jsonl",
        "source": "math"
      }
    ]
  }
}

