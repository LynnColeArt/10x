{
  "name": "main-130m-byte",
  "description": "DGX Spark-targeted dense baseline around the 130M parameter target.",
  "tags": ["baseline", "main-130m", "byte-tokenizer"],
  "paths": {
    "manifest_path": "fixtures/sample-baseline/manifest.json",
    "eval_probes_path": "fixtures/eval/baseline_probes.json",
    "output_dir": "runs"
  },
  "model": {
    "hidden_size": 896,
    "num_layers": 10,
    "num_heads": 14,
    "mlp_ratio": 4.0,
    "dropout": 0.0,
    "max_position_embeddings": 256,
    "norm_type": "rmsnorm",
    "activation": "swiglu",
    "rope_theta": 10000.0
  },
  "training": {
    "sequence_length": 128,
    "micro_batch_size": 2,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.00025,
    "weight_decay": 0.1,
    "warmup_steps": 100,
    "max_steps": 1000,
    "log_every_steps": 20,
    "eval_every_steps": 200,
    "save_every_steps": 200,
    "max_eval_batches": 16,
    "max_grad_norm": 1.0,
    "beta1": 0.9,
    "beta2": 0.95,
    "device": "auto",
    "precision": "auto",
    "compile_model": false,
    "seed": 1234,
    "dataloader_workers": 0
  }
}
